# Project SRT — environment variable template (Rule 7).
# Copy this file to `.env` and fill in real values locally. NEVER commit `.env` itself
# (it is excluded in .gitignore). This file must only ever contain placeholders.

# --- General -----------------------------------------------------------------
ENVIRONMENT=development          # development | testing | production
LOG_LEVEL=INFO

# --- Backend (FastAPI) ---------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Placeholders for later phases (documented now so the shape is known; --
# --- values are not required for Phase 2, and nothing here is implemented --
# --- yet — see docs/ARCHITECTURE.md for what each will back). --------------
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/project_srt
# SECRET_KEY=changeme-generate-a-real-random-value-before-any-non-dev-use
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
