{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "type": "object",

  "properties": {
    "track_id": {
      "type": "integer"
    },

    "camera_id": {
      "type": "string"
    },

    "timestamp": {
      "type": "string",
      "format": "date-time"
    },

    "activity": {
      "type": "string"
    },

    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },

    "temporal_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },

    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },

  "required": [
    "camera_id",
    "timestamp",
    "activity",
    "confidence"
  ]
}