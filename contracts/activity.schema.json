{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project SRT Activity Contract",
  "type": "object",
  "required": [
    "schema_version",
    "camera_id",
    "timestamp",
    "activities"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "camera_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "track_ids",
          "activity_type",
          "confidence"
        ],
        "properties": {
          "track_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "activity_type": {
            "type": "string",
            "enum": [
              "NORMAL",
              "RUNNING",
              "FALL",
              "POSSIBLE_PHYSICAL_ALTERCATION",
              "POSSIBLE_FORCED_MOVEMENT",
              "UNUSUAL_GATHERING",
              "SUDDEN_DISPERSION",
              "PROLONGED_PRESENCE",
              "UNKNOWN"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}