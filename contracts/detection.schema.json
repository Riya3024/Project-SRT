{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "type": "object",

  "properties": {
    "camera_id": {
      "type": "string"
    },

    "frame_id": {
      "type": "integer"
    },

    "timestamp": {
      "type": "string",
      "format": "date-time"
    },

    "detections": {
      "type": "array",

      "items": {
        "type": "object",

        "properties": {
          "detection_id": {
            "type": "string"
          },

          "class": {
            "type": "string"
          },

          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },

          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          }
        },

        "required": [
          "detection_id",
          "class",
          "confidence",
          "bbox"
        ]
      }
    }
  },

  "required": [
    "camera_id",
    "frame_id",
    "timestamp",
    "detections"
  ]
}