{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "type": "object",

  "properties": {
    "anomaly_id": {
      "type": "string"
    },

    "camera_id": {
      "type": "string"
    },

    "timestamp": {
      "type": "string",
      "format": "date-time"
    },

    "track_ids": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },

    "anomaly_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },

    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },

    "uncertainty": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },

    "anomaly_type": {
      "type": "string"
    },

    "baseline_deviation": {
      "type": ["number", "null"]
    },

    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "model_version": {
      "type": ["string", "null"]
    }
  },

  "required": [
    "anomaly_id",
    "camera_id",
    "timestamp",
    "anomaly_score"
  ]
}