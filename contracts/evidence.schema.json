{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "type": "object",

  "properties": {
    "evidence_id": {
      "type": "string"
    },

    "incident_id": {
      "type": ["string", "null"]
    },

    "event_id": {
      "type": ["string", "null"]
    },

    "camera_id": {
      "type": "string"
    },

    "type": {
      "type": "string",
      "enum": [
        "VIDEO",
        "SNAPSHOT",
        "FRAME",
        "ANPR_CROP",
        "FACE_CROP"
      ]
    },

    "storage_uri": {
      "type": "string"
    },

    "start_time": {
      "type": ["string", "null"],
      "format": "date-time"
    },

    "end_time": {
      "type": ["string", "null"],
      "format": "date-time"
    },

    "sha256": {
      "type": ["string", "null"]
    },

    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },

  "required": [
    "evidence_id",
    "camera_id",
    "type",
    "storage_uri"
  ]
}