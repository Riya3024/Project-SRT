{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project SRT Evidence Contract",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_id",
    "incident_id",
    "evidence_type",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "evidence_id": {
      "type": "string"
    },
    "incident_id": {
      "type": "string"
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "SNAPSHOT",
        "VIDEO_CLIP",
        "TIMELINE"
      ]
    },
    "storage_reference": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}