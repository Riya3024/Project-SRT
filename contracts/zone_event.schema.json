{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "type": "object",

  "properties": {
    "zone_id": {
      "type": "string"
    },

    "camera_id": {
      "type": "string"
    },

    "track_id": {
      "type": "integer"
    },

    "event_type": {
      "type": "string",
      "enum": [
        "ZONE_ENTRY",
        "ZONE_EXIT",
        "PROLONGED_DWELL",
        "REPEATED_CROSSING"
      ]
    },

    "timestamp": {
      "type": "string",
      "format": "date-time"
    },

    "dwell_seconds": {
      "type": ["number", "null"]
    },

    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },

  "required": [
    "zone_id",
    "camera_id",
    "track_id",
    "event_type",
    "timestamp"
  ]
}