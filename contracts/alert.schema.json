{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project SRT Alert Contract",
  "type": "object",
  "required": [
    "schema_version",
    "alert_id",
    "incident_id",
    "severity",
    "status",
    "message"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "alert_id": {
      "type": "string"
    },
    "incident_id": {
      "type": "string"
    },
    "severity": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "ACKNOWLEDGED",
        "DISMISSED",
        "ESCALATED"
      ]
    },
    "message": {
      "type": "string"
    }
  }
}