{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project SRT Tracking Contract",
  "type": "object",
  "required": [
    "schema_version",
    "camera_id",
    "timestamp",
    "tracks"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "camera_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "track_id",
          "class_name",
          "confidence",
          "bbox",
          "centroid"
        ],
        "properties": {
          "track_id": {
            "type": "string"
          },
          "class_name": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "centroid": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "velocity": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}