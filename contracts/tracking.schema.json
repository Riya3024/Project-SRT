{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "type": "object",

  "properties": {
    "camera_id": {
      "type": "string"
    },

    "timestamp": {
      "type": "string",
      "format": "date-time"
    },

    "tracks": {
      "type": "array",

      "items": {
        "type": "object",

        "properties": {
          "track_id": {
            "type": "integer"
          },

          "class": {
            "type": "string"
          },

          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },

          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4
          },

          "centroid": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2
          },

          "velocity": {
            "type": "number",
            "minimum": 0
          },

          "acceleration": {
            "type": ["number", "null"]
          },

          "direction": {
            "type": ["number", "null"]
          },

          "track_age": {
            "type": "number",
            "minimum": 0
          },

          "tracking_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },

        "required": [
          "track_id",
          "class",
          "confidence",
          "bbox",
          "centroid"
        ]
      }
    }
  },

  "required": [
    "camera_id",
    "timestamp",
    "tracks"
  ]
}