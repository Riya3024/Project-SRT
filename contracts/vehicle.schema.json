{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-srt.local/contracts/vehicle.schema.json",
  "title": "Project SRT Vehicle Contract",
  "description": "Contract for detected and tracked vehicle observations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vehicle_id",
    "camera_id",
    "track_id",
    "vehicle_class",
    "confidence",
    "timestamp",
    "bbox"
  ],
  "properties": {
    "vehicle_id": {
      "type": "string",
      "minLength": 1
    },
    "camera_id": {
      "type": "string",
      "minLength": 1
    },
    "track_id": {
      "type": "integer",
      "minimum": 0
    },
    "vehicle_class": {
      "type": "string",
      "enum": [
        "car",
        "motorcycle",
        "truck",
        "bus",
        "van",
        "bicycle",
        "other",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "bbox": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "number",
          "minimum": 0
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "centroid": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "direction": {
      "type": "number",
      "minimum": 0,
      "maximum": 360
    },
    "speed": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "zone_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}