{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "type": "object",

  "properties": {
    "camera_id": {
      "type": "string"
    },

    "timestamp": {
      "type": "string",
      "format": "date-time"
    },

    "time_period": {
      "type": "string"
    },

    "day_night": {
      "type": "string",
      "enum": [
        "DAY",
        "NIGHT",
        "LOW_LIGHT",
        "UNKNOWN"
      ]
    },

    "zone_type": {
      "type": ["string", "null"]
    },

    "expected_activity": {
      "type": "string"
    },

    "context_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },

    "context_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },

  "required": [
    "camera_id",
    "timestamp"
  ]
}