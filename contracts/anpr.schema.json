{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-srt.local/contracts/anpr.schema.json",
  "title": "Project SRT ANPR Contract",
  "description": "Contract for automatic number plate recognition results.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anpr_id",
    "camera_id",
    "timestamp",
    "plate_number",
    "confidence",
    "status"
  ],
  "properties": {
    "anpr_id": {
      "type": "string",
      "minLength": 1
    },
    "camera_id": {
      "type": "string",
      "minLength": 1
    },
    "vehicle_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "plate_number": {
      "type": "string",
      "minLength": 1
    },
    "raw_ocr_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "normalized_plate_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "plate_detection_confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "ocr_confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "vehicle_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "VALID",
        "LOW_CONFIDENCE",
        "INVALID",
        "UNKNOWN"
      ]
    },
    "format_valid": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "duplicate_suppressed": {
      "type": "boolean"
    },
    "evidence_image": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}