{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project SRT Risk Contract",
  "type": "object",
  "required": [
    "schema_version",
    "risk_score",
    "severity",
    "reasons"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "severity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}