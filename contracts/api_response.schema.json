{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-srt.local/contracts/api_response.schema.json",
  "title": "Project SRT API Response Contract",
  "description": "Standard response envelope for Project SRT API endpoints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "success",
    "request_id",
    "timestamp"
  ],
  "properties": {
    "success": {
      "type": "boolean"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "data": {},
    "error": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {}
      },
      "required": [
        "code",
        "message"
      ]
    },
    "meta": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "properties": {
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "page_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}